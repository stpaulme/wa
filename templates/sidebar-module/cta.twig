<div class="sidebar-module cta">

    {% set has_image = module.image is defined and module.image %}
    {% set image = has_image ? TimberImage(module.image) : null %}
    
    {% if image and image.src %}
        <img
            class="sidebar-cta-image"
            src="{{ image.src('cta') }}"
            alt="{{ image.alt }}"
        >
    {% endif %}

    <div class="cta-text {{module.image ? 'with-image' : 'without-image'}} {{module.link.url|length > 0 ? 'with-link' : 'without-link'}}">
    
        {% if module.heading %}
            <h3 class="sidebar-cta-heading">{{module.heading}}</h3>
        {% endif %}

        {% if module.copy %}
            {{module.copy}}
        {% endif %}

        {% if module.link %}
            <a class="button button-primary" href="{{module.link.url}}" target="{{module.link.target}}">{{module.link.title}}</a>
        {% endif %}

    </div>
            
</div>