<div class="module cta-group {{module.background_pattern == true ? 'background-pattern' : 'background-white'}}">
    <div class="container">

        {% if module.heading %}
        <div class="row">
            <div class="col">
                <h2>{{module.heading}}</h2>
            </div>
        </div>
        {% endif %}

        
        <div class="row {{module.heading ? 'with-heading' : 'without-heading'}} cta-group-container">

            {% for cta in module.cta_group %}

                <div class="col-lg-4 cta">
                    
                    <div class="row">

                        {% set has_image = cta.image is defined and cta.image %}
                        {% set image = has_image ? TimberImage(cta.image) : null %}
                        {% if image and image.src %}
                            <div class="col-md-6 col-lg-12">
                                <img
                                    class="cta-image"
                                    src="{{ image.src('cta_group') }}"
                                    alt="{{ image.alt }}"
                                >
                            </div>
                        {% endif %}

                        <div class="col-md col-lg-12">

                            <div class="cta-text {{cta.image ? 'with-image' : 'without-image'}} {{cta.link.url|length > 0 ? 'with-link' : 'without-link'}}">

                                {% if cta.heading %}
                                    <h3 class="cta-heading">{{cta.heading}}</h3>
                                {% endif %}

                                {% if cta.copy %}
                                    {{cta.copy}}
                                {% endif %}

                                {% if cta.link %}
                                    <a class="button button-primary" href="{{cta.link.url}}" target="{{cta.link.target}}">{{cta.link.title}}</a>
                                {% endif %}
                                
                            </div>

                        </div>

                    </div>

                </div>
            
            {% endfor %}

        </div>

    </div>
</div>