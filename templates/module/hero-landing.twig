{% set has_image = module.image is defined and module.image %}
{% set image = has_image ? TimberImage(module.image) : null %}

{% if image and image.src %}
    <div class="module hero-landing">
        <img
            class="hero-landing-image"
            alt="{{ image.alt }}"
            src="{{ image.src('hero_landing') }}"
        >
    </div>
{% endif %}
